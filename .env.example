# =============================================================================
# fluig-mcp — configuração de ambiente
#
# Copie para .env (que está no .gitignore) ou defina estas variáveis direto no
# config do seu cliente MCP. NENHUMA tem valor default: um host ou uma senha
# embutidos no código seriam um vazamento esperando acontecer.
# =============================================================================

# -----------------------------------------------------------------------------
# HOMOLOGAÇÃO  (usado quando a chamada passa env="teste")
# -----------------------------------------------------------------------------
FLUIG_HOST=http://fluig-homolog.suaempresa.com.br:8080
FLUIG_USER=seu.usuario
FLUIG_PASS=

# -----------------------------------------------------------------------------
# PRODUÇÃO  (usado quando a chamada passa env="prod")
#
# Opcional: configure só se for operar produção por aqui. A credencial de
# produção NÃO cai na de homologação — esse fallback existia e era uma
# armadilha: mandava a senha de homologação contra produção e queimava
# tentativas do Active Directory, o bastante para bloquear a conta.
# -----------------------------------------------------------------------------
FLUIG_HOST_PROD=https://fluig.suaempresa.com.br:8443
FLUIG_USER_PROD=seu.usuario
FLUIG_PASS_PROD=

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Expõe SOMENTE as ferramentas que não alteram o servidor. Toda tool de escrita
# some da listagem e passa a ser recusada. Recomendado para agente autônomo, e
# obrigatório se você for apontar isto para produção sem supervisão.
# FLUIG_READONLY=1

# -----------------------------------------------------------------------------
# OPCIONAIS
# -----------------------------------------------------------------------------
# Tenant. -1 pede ao servidor para resolver sozinho.
# FLUIG_COMPANY=1
# FLUIG_COMPANY_PROD=1

# Código do colaborador, se diferente do login.
# FLUIG_USERCODE=
# FLUIG_USERCODE_PROD=

# IPs semente, usados quando o DNS interno oscila. São sempre TCP-probados antes
# de usar, e a requisição em si vai pelo HOSTNAME (para o certificado TLS bater e
# para não cair em bloqueio de IPS por acesso via IP). Separe por vírgula.
# FLUIG_IPS=10.0.0.10,10.0.0.11
# FLUIG_IPS_PROD=

# Datasources JNDI do servidor de aplicação.
# FLUIG_DATASOURCE=/jdbc/AppDS
# FLUIG_RM_DATASOURCE=/jdbc/Corpore

# Dataset que faz ponte para as sentenças SQL homologadas do TOTVS RM.
# FLUIG_RM_BRIDGE_DATASET=ds_generic_rm_sql

# Prefixo dos datasets descartáveis que este servidor cria para executar SQL.
# FLUIG_SCRATCH_PREFIX=ds_mcp_
